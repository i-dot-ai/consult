---
import Layout from "../../../layouts/Layout.astro";
import Section from "../../../components/Section/Section.svelte";
import AddConsultationForm from "../../../components/screens/AddConsultationForm/AddConsultationForm.svelte";

import { Routes } from "../../../global/routes";
import { getDataSetupV2Enabled } from "../../../global/utils";

if (!getDataSetupV2Enabled()) {
  return Astro.redirect(Routes.Home);
}
---

<Layout>
  <Section>
    <AddConsultationForm client:load />
  </Section>
</Layout>
