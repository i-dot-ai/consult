---
import Layout from "../../../layouts/Layout.astro";

import Section from "../../../components/Section/Section.svelte";
import type { AstroGlobalRuntime } from "../../../global/types";
import { buildResponse, fetchBackendApi } from "../../../global/api";
import { getApiConsultationUrl } from "../../../global/routes";
import ConsultationView from "../../../components/screens/ConsultationView/ConsultationView.svelte";
import ConsultationDetail from "../../../components/screens/ConsultationDetail/ConsultationDetail.svelte";
import { getDataSetupV2Enabled } from "../../../global/utils";

const { consultationId } = (Astro as unknown as AstroGlobalRuntime).params;

const { error, status } = await fetchBackendApi(
  Astro,
  getApiConsultationUrl(consultationId || ""),
);

if (error) {
  return buildResponse(status);
}

const enableV2 = getDataSetupV2Enabled();
---

<Layout>
  <Section>
    {enableV2 ? (
      <ConsultationView client:load consultationId={consultationId || ""} />
    ) : (
      <ConsultationDetail client:load consultationId={consultationId || ""} />
    )}
  </Section>
</Layout>
