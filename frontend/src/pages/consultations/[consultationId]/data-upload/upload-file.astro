---
import Layout from "../../../../layouts/Layout.astro";

import Section from "../../../../components/Section/Section.svelte";
import FileUpload from "../../../../components/screens/surveyImport/FileUpload/FileUpload.svelte";
import { assertSurveyImportState, getDataSetupV2Enabled, setSurveyImportStatus } from "../../../../global/utils";
import type { AstroGlobalRuntime } from "../../../../global/types";
import type { ConsultationV2 } from "../../../../global/queries/consultations/types";
import { buildResponse, fetchBackendApi } from "../../../../global/api";
import { consultationV2QueryParts } from "../../../../global/queries/consultations/parts";
import { getConsultationViewUrl, getDataUploadDeleteQuestionsUrl } from "../../../../global/routes";

if (!getDataSetupV2Enabled()) {
  return Astro.rewrite("/404");
}

const { consultationId } = (Astro as unknown as AstroGlobalRuntime).params;

const { data, error, status } = await fetchBackendApi<ConsultationV2>(
  Astro,
  consultationV2QueryParts.url(consultationId || ""),
);

if (error) {
  return buildResponse(status);
}

const redirect = assertSurveyImportState(Astro, data);

if (redirect) {
  return redirect;
}

if (data?.survey_import_status === "file_uploading") {
  return Astro.redirect(getConsultationViewUrl(consultationId || ""));
}

if (data?.survey_import_status === "pending_questions") {
  return Astro.redirect(getDataUploadDeleteQuestionsUrl(consultationId || ""));
}
// TODO: Add once demographics url is decided on
// if (data?.survey_import_status === "pending_demographics") {
//   Astro.redirect(getDataUploadDemographicsUrl(consultationId || ""));
// }

await setSurveyImportStatus(Astro, consultationId || "", "viewed_upload");
---

<Layout>
  <Section>
    <FileUpload client:load consultationId={consultationId || ""} />
  </Section>
</Layout>
