---
import Layout from "../../../../layouts/Layout.astro";

import Section from "../../../../components/Section/Section.svelte";
import Overview from "../../../../components/screens/surveyImport/Overview/Overview.svelte";
import type { AstroGlobalRuntime } from "../../../../global/types";
import { buildResponse, fetchBackendApi } from "../../../../global/api";
import { getApiConsultationV2Url } from "../../../../global/routes";
import { assertSurveyImportState } from "../../../../global/utils";
import type { ConsultationV2, SurveyImportStatus } from "../../../../global/queries/consultations/types";

const { consultationId } = (Astro as unknown as AstroGlobalRuntime).params;

const { data, error, status } = await fetchBackendApi<ConsultationV2>(
  Astro,
  getApiConsultationV2Url(consultationId || ""),
);

if (error) {
  return buildResponse(status);
}

const redirect = assertSurveyImportState(Astro, data);

if (redirect) {
  return redirect;
}

await fetchBackendApi(Astro, getApiConsultationV2Url(consultationId || ""), {
  method: "PATCH",
  body: JSON.stringify({
    survey_import_status: "viewed_overview" as SurveyImportStatus,
  }),
});
---

<Layout>
  <Section>
    <Overview client:load consultationId={consultationId || ""} />
  </Section>
</Layout>
