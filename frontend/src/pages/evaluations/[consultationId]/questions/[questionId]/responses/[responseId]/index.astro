---
import Layout from "../../../../../../../layouts/Layout.astro";
import Section from "../../../../../../../components/Section/Section.svelte";
import Text from "../../../../../../../components/Text/Text.svelte";
import Title from "../../../../../../../components/Title.svelte";
import ThemeSelectionForm from "../../../../../../../components/screens/ThemeSelectionForm/ThemeSelectionForm.svelte";
import {
  buildResponse,
  fetchBackendApi,
} from "../../../../../../../global/api";
import type {
  AstroGlobalRuntime,
  Question,
  QuestionResponseResponse,
  ResponseThemeInformation,
} from "../../../../../../../global/types";
import {
  getApiQuestionResponse,
  getApiQuestionUrl,
  getThemeInformationResponse,
  Routes,
} from "../../../../../../../global/routes";

const { consultationId, questionId, responseId } = (
  Astro as unknown as AstroGlobalRuntime
).params;

if (!responseId || !questionId || !consultationId) {
  return (Astro as unknown as AstroGlobalRuntime).redirect(
    Routes.SupportConsultations,
  );
}

const [
  { data: questionData, error: questionError, status: questionStatus },
  { data: responseData, error: responseError, status: responseStatus },
  { data: themesData, error: themesError, status: themesStatus },
] = await Promise.all([
  fetchBackendApi<Question>(
    Astro,
    getApiQuestionUrl(consultationId, questionId),
  ),
  fetchBackendApi<QuestionResponseResponse>(
    Astro,
    getApiQuestionResponse(consultationId, questionId, responseId),
  ),
  fetchBackendApi<ResponseThemeInformation>(
    Astro,
    getThemeInformationResponse(consultationId, questionId, responseId),
  ),
]);

if (questionError) {
  return buildResponse(questionStatus);
}
if (responseError) {
  return buildResponse(responseStatus);
}
if (themesError) {
  return buildResponse(themesStatus);
}
---

<Layout>
  <Section>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="flex flex-col gap-4">
        <div>
          <Title level={1} text={`Question ${questionData?.number}:`} />
          <Title level={1} text={questionData?.question_text} />
        </div>

        <div class="rounded-xl border border-gray-200 bg-gray-50 p-6">
          <Text
            >Response{
              (responseData?.respondent.themefinder_id ||
                responseData?.respondent.themefinder_id === 0) &&
                ` ${responseData?.respondent.themefinder_id}`
            }:</Text
          >
          <div class="mt-3">
            <Text>{responseData?.free_text_answer_text}</Text>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <div>
          <Title level={2} text="Select Themes" />
          <Text>Which themes apply to this response?</Text>
        </div>
        <ThemeSelectionForm
          client:load
          responseId={responseData?.id || ""}
          allThemes={themesData?.all_themes || []}
          selectedThemes={themesData?.selected_themes || []}
          consultationId={consultationId}
          questionId={questionId}
        />
      </div>
    </div>
  </Section>
</Layout>
