---
import { buildResponse, fetchBackendApi } from "../../../global/api";
import type {
  AstroGlobalRuntime,
  ConsultationResponse,
  Question,
} from "../../../global/types";

import Layout from "../../../layouts/Layout.astro";
import Section from "../../../components/Section/Section.svelte";
import Title from "../../../components/Title.svelte";
import Link from "../../../components/Link.svelte";
import {
  getApiConsultationUrl,
  getApiQuestionsUrl,
} from "../../../global/routes";
import { Routes } from "../../../global/routes";
import QuestionsReviewList from "../../../components/screens/QuestionsReviewList/QuestionsReviewList.svelte";

const { consultationId = "" } = (Astro as unknown as AstroGlobalRuntime).params;

const {
  data: consultationData,
  error: consultationError,
  status: consultationStatus,
} = await fetchBackendApi<ConsultationResponse>(
  Astro,
  getApiConsultationUrl(consultationId),
);

const {
  data: questions,
  error: questionsError,
  status: questionsStatus,
} = await fetchBackendApi<{ results: Question[] }>(
  Astro,
  getApiQuestionsUrl(consultationId, {
    include: "proportion_of_audited_answers",
  }),
);

if (consultationError) {
  return buildResponse(consultationStatus);
}
if (questionsError) {
  return buildResponse(questionsStatus);
}
---

<Layout>
  <Section>
    <Title level={1} text={consultationData?.title} />
    <Link href={Routes.Consultations}>Back to your consultations</Link>

    <h2>All free text questions for review</h2>

    <QuestionsReviewList
      client:load
      consultationId={consultationId}
      questions={questions?.results || []}
    />
  </Section>
</Layout>
