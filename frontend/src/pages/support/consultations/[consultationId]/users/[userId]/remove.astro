---
import { buildResponse, fetchBackendApi } from "../../../../../../global/api";
import type {
  AstroGlobalRuntime,
  ConsultationResponse,
  User,
} from "../../../../../../global/types";

import Layout from "../../../../../../layouts/Layout.astro";
import Section from "../../../../../../components/Section/Section.svelte";
import Title from "../../../../../../components/Title.svelte";
import {
  getApiConsultationUrl,
  getApiUserDetails,
  Routes,
} from "../../../../../../global/routes";
import RemoveUserFromConsultationForm from "../../../../../../components/screens/RemoveUserFromConsultationForm.svelte";

const { consultationId, userId } = (Astro as unknown as AstroGlobalRuntime)
  .params;

if (!consultationId || !userId) {
  return (Astro as unknown as AstroGlobalRuntime).redirect(
    Routes.SupportConsultations,
  );
}

let {
  data: consultationData,
  error: consultationError,
  status: consultationStatus,
} = await fetchBackendApi<ConsultationResponse>(
  Astro,
  getApiConsultationUrl(consultationId),
);

let {
  data: userData,
  error: userError,
  status: userStatus,
} = await fetchBackendApi<User>(Astro, getApiUserDetails(userId));

if (consultationError) {
  return buildResponse(consultationStatus);
}

if (userError) {
  return buildResponse(userStatus);
}
---

<Layout>
  <Section>
    <Title level={1} text="Remove user from consultation" />
    <RemoveUserFromConsultationForm
      client:load
      user={userData!}
      consultation={consultationData!}
    />
  </Section>
</Layout>
