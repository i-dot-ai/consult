---
import { buildResponse, fetchBackendApi } from "../../../../../../global/api";
import type {
  AstroGlobalRuntime,
  ConsultationResponse,
  Question,
} from "../../../../../../global/types";

import Layout from "../../../../../../layouts/Layout.astro";
import Section from "../../../../../../components/Section/Section.svelte";
import Title from "../../../../../../components/Title.svelte";
import {
  getApiConsultationUrl,
  getApiQuestionUrl,
  Routes,
} from "../../../../../../global/routes";
import DeleteQuestionForm from "../../../../../../components/screens/DeleteQuestionForm.svelte";

const { consultationId, questionId } = (Astro as unknown as AstroGlobalRuntime)
  .params;

if (!consultationId || !questionId) {
  return (Astro as unknown as AstroGlobalRuntime).redirect(
    Routes.SupportConsultations,
  );
}

let {
  data: consultationData,
  error: consultationError,
  status: consultationStatus,
} = await fetchBackendApi<ConsultationResponse>(
  Astro,
  getApiConsultationUrl(consultationId),
);

let {
  data: questionData,
  error: questionError,
  status: questionStatus,
} = await fetchBackendApi<Question>(
  Astro,
  getApiQuestionUrl(consultationId, questionId),
);

if (consultationError) {
  return buildResponse(consultationStatus);
}

if (questionError) {
  return buildResponse(questionStatus);
}
---

<Layout>
  <Section>
    <Title level={1} text="Delete question" />
    <DeleteQuestionForm
      client:load
      consultation={consultationData!}
      question={questionData!}
    />
  </Section>
</Layout>
