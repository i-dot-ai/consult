---
import { buildResponse, fetchBackendApi } from "../../../global/api";
import type { Consultation } from "../../../global/types";

import Layout from "../../../layouts/Layout.astro";
import Section from "../../../components/Section/Section.svelte";
import { Routes } from "../../../global/routes";
import ManageConsultationsArchive from "../../../components/screens/ManageConsultationsArchive/ManageConsultationsArchive.svelte";

const {
  data: consultationData,
  error: consultationError,
  status: consultationStatus,
} = await fetchBackendApi<{ results: Consultation[] }>(
  Astro,
  Routes.ApiConsultations,
);
const consultations = consultationData?.results || [];

if (consultationError) {
  return buildResponse(consultationStatus);
}
---

<Layout>
  <Section>
    <ManageConsultationsArchive client:load consultations={consultations} />
  </Section>
</Layout>
