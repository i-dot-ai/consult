ENVIRONMENT=TEST
DEBUG=True
DATA_SETUP_V2_ENABLED=true
DJANGO_SECRET_KEY=dummy-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BATCH_JOB_QUEUE=dummy-queue
BATCH_JOB_DEFINITION=dummy-definition
AWS_REGION=eu-west-2
AWS_BUCKET_NAME=i-dot-ai-test-consult-data
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=30
ASSIGN_THEMES_BATCH_JOB_NAME=i-dot-ai-dev-consult-assign-themes-job
ASSIGN_THEMES_BATCH_JOB_QUEUE=i-dot-ai-dev-consult-mapping-FARGATE-batch-job-queue
ASSIGN_THEMES_BATCH_JOB_DEFINITION=i-dot-ai-dev-consult-mapping-FARGATE-batch-job-definition
FIND_THEMES_BATCH_JOB_NAME=i-dot-ai-dev-consult-find-themes-job
FIND_THEMES_BATCH_JOB_QUEUE=i-dot-ai-dev-consult-sign-off-FARGATE-batch-job-queue
FIND_THEMES_BATCH_JOB_DEFINITION=i-dot-ai-dev-consult-sign-off-FARGATE-batch-job-definition
LITELLM_CONSULT_OPENAI_API_KEY=insert-litellm-api-key-here
LLM_GATEWAY_URL=https://llm-gateway.i.ai.gov.uk
ADMIN_USERS=admin@example.com,policy@example.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://collector-test:4317
OTEL_SERVICE_NAME=consult-backend-test
PUBLIC_DATA_SETUP_V2_ENABLED=true

# ThemeFinder evals (themefinder/evals). They read this top-level .env, and only it:
# a themefinder/.env would shadow this file entirely. They share LLM_GATEWAY_URL above.
CONSULT_EVAL_LITELLM_API_KEY=
# Task model under evaluation. Prefilled with a known working value,
# otherwise it fails silently later.
AUTO_EVAL_MODEL=gpt-4.1-sweden-2025-03
# Judge/scoring model; required for every eval except mapping
AUTO_EVAL_JUDGE_MODEL=gpt-4.1-sweden-2025-03
# Evaluation dataset and artefact backends: local or langfuse (default: local)
THEMEFINDER_EVAL_DATASET_SOURCE=local
THEMEFINDER_EVAL_ARTEFACT_STORE=local
# Required when either evaluation backend above is set to langfuse.
# Optional otherwise: when set, every run is also traced to Langfuse.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_PROJECT_ID=
